# Stage 1: Build the web client
FROM node:24-alpine AS build

WORKDIR /app/client
COPY client/package.json client/package-lock.json ./
RUN npm ci --ignore-scripts

COPY client/ .
COPY sdk/ /app/sdk/
RUN ln -s /app/client/node_modules /app/sdk/node_modules
# Make the WASM package available for Vite resolution
RUN ln -s /app/sdk/wasm/pkg /app/client/node_modules/vesper-openmls-wasm
# Copy the packaged Twemoji SVG assets into the web bundle.
RUN node -e "const fs=require('fs');const src='node_modules/@twemoji/svg';const dst='src/renderer/public/twemoji';if(!fs.existsSync(src))throw new Error('twemoji SVGs missing');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){if(f.endsWith('.svg'))fs.copyFileSync(src+'/'+f,dst+'/'+f)}console.log('Copied '+fs.readdirSync(dst).length+' twemoji SVGs')"
RUN npm run build:web

# Stage 2: Serve with nginx
FROM nginx:alpine

COPY --from=build /app/client/dist-web /usr/share/nginx/html
RUN printf 'window.VESPER_API_URL = window.location.origin;\n' > /usr/share/nginx/html/config.js

# SPA fallback, cache headers, and same-origin API proxy
RUN printf 'proxy_set_header Host $host;\n\
proxy_set_header X-Real-IP $remote_addr;\n\
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
proxy_set_header X-Forwarded-Proto $vesper_forwarded_proto;\n' > /etc/nginx/conf.d/proxy_headers.inc
RUN printf 'upstream vesper_api {\n\
    server app:4000;\n\
}\n\
\n\
map $http_x_forwarded_proto $vesper_forwarded_proto {\n\
    default $http_x_forwarded_proto;\n\
    "" $scheme;\n\
}\n\
\n\
server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    add_header Content-Security-Policy "default-src '\''self'\''; script-src '\''self'\''; style-src '\''self'\'' '\''unsafe-inline'\''; img-src '\''self'\'' data: blob: https:; font-src '\''self'\'' data:; connect-src '\''self'\'' https: wss:; media-src '\''self'\'' blob:; worker-src '\''self'\'' blob:; child-src '\''self'\'' blob:; object-src '\''none'\''; base-uri '\''none'\''; form-action '\''self'\''; frame-ancestors '\''none'\''; frame-src '\''none'\''; manifest-src '\''self'\''" always;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    add_header Referrer-Policy "no-referrer" always;\n\
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()" always;\n\
    \n\
    # Twemoji SVGs: immutable, cache forever\n\
    location /twemoji/ {\n\
        add_header Cache-Control "public, max-age=31536000, immutable";\n\
        try_files $uri =404;\n\
    }\n\
    \n\
    # Vite hashed assets: immutable\n\
    location /assets/ {\n\
        add_header Cache-Control "public, max-age=31536000, immutable";\n\
        try_files $uri =404;\n\
    }\n\
    \n\
    location /api/ {\n\
        proxy_pass http://vesper_api;\n\
        include /etc/nginx/conf.d/proxy_headers.inc;\n\
    }\n\
    \n\
    location /uploads/ {\n\
        proxy_pass http://vesper_api;\n\
        include /etc/nginx/conf.d/proxy_headers.inc;\n\
    }\n\
    \n\
    location /socket/ {\n\
        proxy_pass http://vesper_api;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        include /etc/nginx/conf.d/proxy_headers.inc;\n\
        proxy_read_timeout 86400;\n\
    }\n\
    \n\
    location /health {\n\
        proxy_pass http://vesper_api;\n\
        include /etc/nginx/conf.d/proxy_headers.inc;\n\
    }\n\
    \n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]

EXPOSE 80
