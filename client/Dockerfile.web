# Stage 1: Build the web client
FROM node:24-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS build

WORKDIR /app/client
COPY client/package.json client/package-lock.json ./
RUN npm ci --ignore-scripts

COPY client/ .
COPY sdk/ /app/sdk/
RUN ln -s /app/client/node_modules /app/sdk/node_modules
# Make the WASM package available for Vite resolution
RUN ln -s /app/sdk/wasm/pkg /app/client/node_modules/vesper-openmls-wasm
# Copy the packaged Twemoji SVG assets into the web bundle.
RUN node -e "const fs=require('fs');const src='node_modules/@twemoji/svg';const dst='src/renderer/public/twemoji';if(!fs.existsSync(src))throw new Error('twemoji SVGs missing');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){if(f.endsWith('.svg'))fs.copyFileSync(src+'/'+f,dst+'/'+f)}console.log('Copied '+fs.readdirSync(dst).length+' twemoji SVGs')"
RUN npm run build:web

# Stage 2: serve as the image's fixed nginx user. Configuration and application
# assets remain root-owned/read-only; only bounded runtime state lives in /tmp.
FROM nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752

COPY --from=build /app/client/dist-web /usr/share/nginx/html
COPY client/docker/nginx.conf /etc/nginx/nginx.conf
COPY client/docker/default.conf /etc/nginx/conf.d/default.conf
COPY client/docker/proxy_headers.inc.template /etc/nginx/vesper/proxy_headers.inc.template
COPY client/docker-entrypoint.d/40-vesper-public-scheme.sh /usr/local/bin/vesper-web-entrypoint

RUN chmod 0555 /usr/local/bin/vesper-web-entrypoint && \
    printf 'window.VESPER_API_URL = window.location.origin;\n' > /usr/share/nginx/html/config.js && \
    chmod -R a-w /etc/nginx /usr/share/nginx/html

USER nginx
ENTRYPOINT ["/usr/local/bin/vesper-web-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]

EXPOSE 8080
