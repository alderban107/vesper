{
  "name": "vesper",
  "version": "0.1.0",
  "description": "Vesper — encrypted messaging",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:web": "npm run typecheck && npm run build:web",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test:e2e": "npm run test:integration -w @vesper/sdk",
    "test:e2e:watch": "npm run test:integration:watch -w @vesper/sdk"
  },
  "keywords": [
    "messaging",
    "e2ee",
    "encryption",
    "electron",
    "webrtc"
  ],
  "author": "alderban107",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/alderban107/vesper.git"
  },
  "homepage": "https://github.com/alderban107/vesper",
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "agentation": "^2.3.3",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hpke/core": "^1.8.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "buffer": "^6.0.3",
    "electron-updater": "^6.8.3",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.38",
    "lucide-react": "^0.576.0",
    "mermaid": "^11.12.0",
    "music-metadata-browser": "^2.5.11",
    "phoenix": "^1.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.1",
    "ts-mls": "^1.6.1",
    "zustand": "^5.0.11"
  }
}
