# Vesper — Environment Variables
# Copy this file to .env and edit. See README.md for full reference.

# =============================================================================
# Release Images
# =============================================================================

# Pin both services to the same published release version (or, preferably, to
# the immutable digests shown by `docker buildx imagetools inspect`). Never use
# main/latest for a production deployment.
VESPER_APP_IMAGE=ghcr.io/alderban107/vesper-app:replace-with-release-version
VESPER_WEB_IMAGE=ghcr.io/alderban107/vesper-web:replace-with-release-version

# =============================================================================
# Database
# =============================================================================

POSTGRES_USER=vesper
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=vesper_prod

# Connection pool size (default 10)
# POOL_SIZE=10

# Set to true or 1 to connect to PostgreSQL over IPv6
# ECTO_IPV6=

# =============================================================================
# Server
# =============================================================================

SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
PHX_HOST=localhost
APP_PORT=4000

# Public deployments default to closed registration. Supported values:
# closed, open, invite_only. invite_only also requires REGISTRATION_INVITE_SECRET.
REGISTRATION_MODE=closed
# REGISTRATION_INVITE_SECRET=

# Separate JWT signing key (defaults to SECRET_KEY_BASE if not set)
# JWT_SECRET=

# Bearer token for the protected /metrics endpoint (minimum 32 bytes).
# This deliberately short placeholder makes production startup fail until replaced.
METRICS_TOKEN=change-me

# DNS query for clustering in multi-node deployments
# DNS_CLUSTER_QUERY=

# =============================================================================
# CORS & Origins
# =============================================================================

# Allowed origins for CORS and WebSocket connections. This is required in
# production and wildcards are rejected. Use a comma-separated list when the
# web client and packaged desktop client have distinct origins.
CORS_ORIGIN=http://localhost:8080

# =============================================================================
# Voice / WebRTC
# =============================================================================

TURN_PASSWORD=change-me-to-a-strong-password

# TURN server URL (default: turn:coturn:3478)
# For proxied web deployments: turns:your-host:443?transport=tcp
# TURN_SERVER_URL=turn:coturn:3478

# TURN username (default: vesper)
# TURN_USERNAME=vesper

# ICE transport policy: "all" (STUN + TURN) or "relay" (TURN only)
# Defaults to "relay" when TURN is configured, "all" otherwise.
# VOICE_ICE_TRANSPORT_POLICY=

# =============================================================================
# File Storage
# =============================================================================

# Days before uploaded files are deleted (default 30)
# FILE_EXPIRY_DAYS=30

# =============================================================================
# Web Client (Docker)
# =============================================================================

# The Docker web image proxies API and WebSocket traffic to the app service,
# so the browser remains same-origin by default.

# Public scheme at the trusted edge. Set to https when TLS terminates at a
# reverse proxy in front of the web container; inbound forwarding headers are ignored.
PUBLIC_SCHEME=http

# External port for the web client (default 8080)
# WEB_PORT=8080

# =============================================================================
# Local Source / Test Postgres
# =============================================================================

# Shared local PostgreSQL settings for Phoenix dev, SDK live tests, and Playwright.
# The helper scripts and Node test harnesses read these from the repo root .env.
# DEV_DB_HOST=127.0.0.1
# DEV_DB_PORT=55432
# DEV_DB_USER=vesper_sdk
# DEV_DB_PASS=vesper_sdk
# DEV_DB_NAME=vesper_dev
#
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=55432
# TEST_DB_USER=vesper_sdk
# TEST_DB_PASS=vesper_sdk
#
# VESPER_SDK_TEST_DB_HOST=127.0.0.1
# VESPER_SDK_TEST_DB_PORT=55432
# VESPER_SDK_TEST_DB_USER=vesper_sdk
# VESPER_SDK_TEST_DB_PASS=vesper_sdk
