# Vesper — Environment Variables
# Copy this file to .env and edit. See README.md for full reference.

# =============================================================================
# Database
# =============================================================================

POSTGRES_USER=vesper
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=vesper_prod

# Connection pool size (default 10)
# POOL_SIZE=10

# Set to true or 1 to connect to PostgreSQL over IPv6
# ECTO_IPV6=

# =============================================================================
# Server
# =============================================================================

SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
PHX_HOST=localhost
APP_PORT=4000

# Separate JWT signing key (defaults to SECRET_KEY_BASE if not set)
# JWT_SECRET=

# DNS query for clustering in multi-node deployments
# DNS_CLUSTER_QUERY=

# =============================================================================
# CORS & Origins
# =============================================================================

# Allowed origin for CORS and WebSocket connections.
# Set to your frontend URL in production (e.g. https://app.example.com).
# Comma-separated for multiple origins. Unset allows all origins with a warning.
# CORS_ORIGIN=

# =============================================================================
# Voice / WebRTC
# =============================================================================

TURN_PASSWORD=change-me-to-a-strong-password

# TURN server URL (default: turn:coturn:3478)
# For proxied web deployments: turns:your-host:443?transport=tcp
# TURN_SERVER_URL=turn:coturn:3478

# TURN username (default: vesper)
# TURN_USERNAME=vesper

# ICE transport policy: "all" (STUN + TURN) or "relay" (TURN only)
# Defaults to "relay" when TURN is configured, "all" otherwise.
# VOICE_ICE_TRANSPORT_POLICY=

# =============================================================================
# File Storage
# =============================================================================

# Days before uploaded files are deleted (default 30)
# FILE_EXPIRY_DAYS=30

# =============================================================================
# Web Client (Docker)
# =============================================================================

# Full URL to the API server (e.g. https://vesper.yourdomain.com)
# When empty, the web client connects to the same host it's served from.
# API_URL=

# External port for the web client (default 8080)
# WEB_PORT=8080
